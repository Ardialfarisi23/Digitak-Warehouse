# Database
DATABASE_URL=

# JWT
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=3d
JWT_ACCESS_EXPIRES=60m

# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Trust Proxy (for rate limiting behind reverse proxy)
TRUST_PROXY=true

# Seed Default Password (hanya untuk development)
# SEED_DEFAULT_PASSWORD=DevSeed123
# PERINGATAN: Jangan dipakai di production kecuali diganti segera.
# Jika kosong di production, seed user akan ditolak.

# Rate Limits (optional, defaults shown)
LONGGAR_LOGIN_LIMIT=20
LONGGAR_LOGIN_WINDOW=15
LONGGAR_PASSWORD_RESET_LIMIT=10
LONGGAR_PASSWORD_RESET_WINDOW=15
LONGGAR_REFRESH_LIMIT=60
LONGGAR_REFRESH_WINDOW=15
LONGGAR_UPLOAD_LIMIT=60
LONGGAR_UPLOAD_WINDOW=15
LONGGAR_DELETE_LIMIT=60
LONGGAR_DELETE_WINDOW=15
# CORS/Proxy (opsional - diimplementasi hardcoded di app.js; tambahkan ke allowedOrigins jika perlu)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

